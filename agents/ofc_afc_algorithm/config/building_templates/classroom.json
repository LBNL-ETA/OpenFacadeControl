{
  "template_name": "Educational Classroom",
  "template_version": "1.0", 
  "description": "Configuration template for educational classroom spaces",
  "building": {
    "type": "classroom",
    "size_category": "medium",
    "year_built": "new_construction",
    "geometry": {
      "room_width": 8.0,
      "room_height": 3.2,
      "room_depth": 6.0,
      "window_width": 4.0,
      "window_height": 2.4,
      "window_sill": 0.8,
      "window_count": 2,
      "orientation": 180,
      "floor_area": 48.0,
      "ceiling_height": 3.2,
      "window_to_wall_ratio": 0.35
    },
    "facade_system": "automated_blind",
    "hvac_system": "heat_pump",
    "lighting_system": "LED",
    "controls": {
      "daylight_control": true,
      "occupancy_control": true,
      "demand_response": true,
      "presentation_mode": true
    },
    "occupancy": {
      "max_occupants": 30,
      "occupant_density": 0.6,
      "schedule": "educational",
      "occupant_direction": "n",
      "occupant_distance": 3.0,
      "brightness_preference": 500,
      "glare_tolerance": 20
    },
    "thermal": {
      "r_value_wall": 3.0,
      "r_value_roof": 4.5,
      "infiltration_rate": 0.15,
      "thermal_mass": "medium"
    }
  },
  "afc": {
    "optimization_horizon": 8,
    "timestep_minutes": 30,
    "comfort_weights": {
      "glare": 0.35,
      "daylight": 0.35,
      "energy": 0.3
    },
    "control_priorities": {
      "visual_comfort": 0.4,
      "occupant_comfort": 0.35,
      "energy_efficiency": 0.25
    },
    "constraints": {
      "min_daylight_factor": 0.03,
      "max_glare_dgp": 0.35,
      "min_illuminance": 300,
      "max_illuminance": 1000,
      "temp_range_occupied": {"min": 20, "max": 25},
      "temp_range_unoccupied": {"min": 16, "max": 28}
    },
    "operating_modes": {
      "lecture": {
        "glare_priority": 0.5,
        "illuminance_target": 500
      },
      "presentation": {
        "glare_priority": 0.7,
        "illuminance_target": 200,
        "facade_override": true
      },
      "break": {
        "energy_priority": 0.6,
        "illuminance_target": 300
      }
    }
  },
  "devices": {
    "facade": [
      {
        "type": "automated_blind",
        "zones": ["zone_0", "zone_1"],
        "control_range": {"min": 0.0, "max": 1.0},
        "response_time": 30,
        "presentation_mode": true,
        "states": {
          "0.0": {"description": "Fully closed"},
          "0.33": {"description": "33% open"},
          "0.66": {"description": "66% open"},
          "1.0": {"description": "Fully open"}
        }
      }
    ],
    "lighting": [
      {
        "type": "dimmable_led",
        "zones": ["zone_0", "zone_1"],
        "control_range": {"min": 0.0, "max": 1.0},
        "power_rating": 40,
        "efficacy": 130,
        "scenes": ["lecture", "presentation", "break"]
      }
    ],
    "hvac": [
      {
        "type": "heat_pump",
        "zones": ["zone_0", "zone_1"],
        "control_type": "temperature",
        "capacity": {"cooling": 6000, "heating": 4000},
        "ventilation_rate": 8
      }
    ]
  },
  "sensors": {
    "required": [
      "occupancy_sensor",
      "illuminance_sensor",
      "glare_sensor",
      "temperature_sensor"
    ],
    "optional": [
      "co2_sensor",
      "humidity_sensor",
      "noise_sensor",
      "presentation_sensor"
    ],
    "sampling_interval": 60
  },
  "weather": {
    "required_parameters": ["dni", "dhi", "temp_air", "wind_speed"],
    "forecast_horizon": 12,
    "update_frequency": 3600
  }
}